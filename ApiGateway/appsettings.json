{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiKeySettings": {
    "ApiKey": "MY_SECRET_KEY_CarRentalVP"
  },
  "GatewayAccess": {
    "InternalSecret": "ONLY_GATEWAY_CAN_CALL_APIS"
  },
  "ReverseProxy": {
    "Routes": {
      "customers-route": {
        "ClusterId": "customers-cluster",
        "Match": {
          "Path": "/gateway/customers/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/Customers/{**catch-all}" },
          {
            "RequestHeader": "X-Internal-Gateway",
            "Set": "ONLY_GATEWAY_CAN_CALL_APIS"
          }
        ]
      },
      "inventories-route": {
        "ClusterId": "inventories-cluster",
        "Match": {
          "Path": "/gateway/inventories/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/Inventories/{**catch-all}" },
          {
            "RequestHeader": "X-Internal-Gateway",
            "Set": "ONLY_GATEWAY_CAN_CALL_APIS"
          }
        ]
      },
      "maintenance-route": {
        "ClusterId": "maintenance-cluster",
        "Match": {
          "Path": "/gateway/maintenance/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/maintenance/{**catch-all}" },
          {
            "RequestHeader": "X-Internal-Gateway",
            "Set": "ONLY_GATEWAY_CAN_CALL_APIS"
          }
        ]
      }
    },
    "Clusters": {
      "customers-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7199/"
          }
        }
      },
      "inventories-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7268/"
          }
        }
      },
      "maintenance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7208/"
          }
        }
      }
    }
  }
}

